{
  "doctype": "DocType",
  "name": "Meta Conversion Settings",
  "module": "Meta Conversion",
  "engine": "InnoDB",
  "istable": 0,
  "issingle": 1,
  "field_order": [
    "enabled",
    "trigger_status",
    "allowed_invoice_statuses",
    "channel_account",
    "provider_contract_confirmed",
    "status_configuration_initialized",
    "go_live",
    "encounter_types",
    "sales_types",
    "encounter_places",
    "provider_url",
    "api_token",
    "test_mode"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check"
    },
    {
      "fieldname": "trigger_status",
      "label": "Trigger Status",
      "fieldtype": "Select",
      "options": "Paid",
      "default": "Paid",
      "reqd": 0,
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "go_live",
      "label": "Go Live",
      "fieldtype": "Datetime",
      "reqd": 1,
      "description": "Only invoices created on or after this cutoff qualify. Set before enabling; historical invoices are excluded."
    },
    {
      "fieldname": "encounter_types",
      "label": "Encounter Types",
      "fieldtype": "Table MultiSelect",
      "options": "Meta Conversion Type Filter"
    },
    {
      "fieldname": "sales_types",
      "label": "Sales Types",
      "fieldtype": "Table MultiSelect",
      "options": "Meta Conversion Sales Filter"
    },
    {
      "fieldname": "encounter_places",
      "label": "Encounter Places",
      "fieldtype": "Table MultiSelect",
      "options": "Meta Conversion Place Filter"
    },
    {
      "fieldname": "provider_url",
      "label": "Provider Url",
      "fieldtype": "Data",
      "description": "Approved Interakt API origin. The conversion endpoint must be confirmed with Interakt.",
      "default": "https://api.interakt.ai"
    },
    {
      "fieldname": "api_token",
      "label": "Api Token",
      "fieldtype": "Password",
      "hidden": 1,
      "read_only": 1,
      "description": "Legacy credential; no longer used."
    },
    {
      "fieldname": "test_mode",
      "label": "Test Mode",
      "fieldtype": "Check",
      "default": "1",
      "description": "Local eligibility check only. No request is sent."
    },
    {
      "fieldname": "allowed_invoice_statuses",
      "label": "Allowed Invoice Statuses",
      "fieldtype": "Table MultiSelect",
      "options": "Meta Conversion Status Filter",
      "description": "Unpaid includes both COD and prepaid invoices. All other encounter filters must also match."
    },
    {
      "fieldname": "channel_account",
      "label": "Chat Channel Account",
      "fieldtype": "Link",
      "options": "Chat Channel Account",
      "description": "Reuse the Interakt API key stored on this account."
    },
    {
      "fieldname": "provider_contract_confirmed",
      "label": "Provider Contract Confirmed",
      "fieldtype": "Check",
      "default": "0",
      "description": "Enable only after Interakt confirms /v1/public/track/conversions/, this payload, and access for the selected account."
    },
    {
      "fieldname": "status_configuration_initialized",
      "label": "Status Configuration Initialized",
      "fieldtype": "Check",
      "hidden": 1,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 0,
      "report": 1,
      "export": 1
    }
  ],
  "track_changes": 1
}
